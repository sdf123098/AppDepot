<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <Compile Include="../../Raven/Helpers/ResourceExtensions.cs" Link="ResourceExtensions.cs" />
    <Content Include="$(RavenPublishDir)/Raven.pri" Link="LocalizationSmoke.pri" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
